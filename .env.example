# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://my-app-url.com"

# REACT_APP_ERROR_LOG_ENDPOINT: Endpoint to send error logs for monitoring and debugging.
# If not set, errors are logged locally only (to browser localStorage and console).
# Example: "https://my-app-url.com/api/errors" or "/api/errors" (relative)
REACT_APP_ERROR_LOG_ENDPOINT="/api/errors"
