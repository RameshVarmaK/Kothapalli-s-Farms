# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://my-app-url.com"

# REACT_APP_ERROR_LOG_ENDPOINT: Endpoint to send error logs for monitoring and debugging.
# If not set, errors are logged locally only (to browser localStorage and console).
# Example: "https://my-app-url.com/api/errors" or "/api/errors" (relative)
REACT_APP_ERROR_LOG_ENDPOINT="/api/errors"

# Firebase Admin SDK credentials for backend sync endpoints
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_DATABASE_URL="https://your-project.firebaseio.com"
FIREBASE_ADMIN_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'
